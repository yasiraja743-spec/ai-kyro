{
  "version": 2,
  "buildCommand": "true",
  "outputDirectory": ".",
  "installCommand": "true",
  "functions": {
    "api/index.js": { "maxDuration": 5 },
    "api/chat.js": { "maxDuration": 30 },
    "api/upload-image.js": { "maxDuration": 30 },
    "api/edit-photo.js": { "maxDuration": 60 },
    "api/generate-image.js": { "maxDuration": 60 },
    "api/health.js": { "maxDuration": 5 },
    "api/docs.js": { "maxDuration": 5 },
    "api/_hf.js": { "maxDuration": 5 }
  },
  "rewrites": [
    { "source": "/api/docs", "destination": "/api/docs.js" },
    { "source": "/api-docs.html", "destination": "/api/docs.js" },
    { "source": "/api/docs.html", "destination": "/api/docs.js" },
    { "source": "/api/health", "destination": "/api/health.js" },
    { "source": "/api/(.+)", "destination": "/api/$1.js" },
    { "source": "/(.*)", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'"
        }
      ]
    },
    {
      "source": "/.*",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
