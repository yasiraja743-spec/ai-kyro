# Vercel environment variables
# Point Vercel to the ONE public ONYX AI gateway running on your VPS.
ONYX_GATEWAY_URL=https://ai.example.com
ONYX_GATEWAY_SECRET=CHANGE_ME_LONG_RANDOM_SECRET

ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# Vercel Firebase Admin (server-side only)
FIREBASE_PROJECT_ID=login-kyro
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
